# ── Production budget env (ticket #27, spec §9.2) ───────────────────────────
# Recommended production tiers from docs/research/media-budget-tuning.md §2.
# These are STARTING tiers to be tightened/loosened via the runtime-data
# feedback loop in §3 (observe upload_sessions + rejection rates → adjust →
# restart → re-run tests). Copy this file to the deployment host's env and
# review each value against actual production observability before going live.

# Scene resource budgets (server/demonstration/sceneSecurity.ts).
# V1 conservative defaults → production loosened for teacher-authored 3D.
DEMO_BUDGET_MAX_NODES=4000
DEMO_BUDGET_MAX_TRIANGLES=500000
DEMO_BUDGET_MAX_TEXTURE_PIXELS=16777216
DEMO_BUDGET_MAX_ANIMATION_SECONDS=600
DEMO_BUDGET_MAX_MEDIA_REFS=200

# Per-kind media upload caps (server/media/mediaGate.ts). Bytes.
# GLB raised for complex mechanical/molecular models; imagery pinned by
# decoded-pixel constraints; video/audio bounded by duration not bytes.
MEDIA_LIMIT_IMAGE_BYTES=26214400
MEDIA_LIMIT_GLB_BYTES=314572800
MEDIA_LIMIT_VIDEO_BYTES=2147483648
MEDIA_LIMIT_VTT_BYTES=2097152
MEDIA_LIMIT_AUDIO_BYTES=262144000

# Per-teacher logical upload quota (server/media/QuotaService.ts). Bytes.
# Raised from 5 GiB to 10 GiB for video-heavy teachers; confirm against
# runtime upload_sessions usage distribution (feedback loop §3).
MEDIA_QUOTA_TEACHER_BYTES=10737418240