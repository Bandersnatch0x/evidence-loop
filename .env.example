# Optional. When unset, EvidenceRing uses deterministic local feedback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Runner mode. subprocess is the local-demo default; docker enables
# network and resource isolation and fails closed when Docker is unavailable.
PYTHON_RUNNER=subprocess
PYTHON_BIN=python
PYTHON_RUNNER_TIMEOUT_MS=1500

# Docker runner settings. Build docker/python-runner for a pinned local image,
# or keep the official Python image shown here.
DOCKER_BIN=docker
DOCKER_RUNNER_IMAGE=python:3.12-slim
DOCKER_RUNNER_POOL_SIZE=2
DOCKER_RUNNER_TIMEOUT_MS=1500
DOCKER_RUNNER_STARTUP_TIMEOUT_MS=15000
DOCKER_RUNNER_MEMORY=128m
DOCKER_RUNNER_MEMORY_SWAP=128m
DOCKER_RUNNER_CPUS=0.5
DOCKER_RUNNER_TMPFS=/tmp:noexec,nosuid,size=100m
DOCKER_RUNNER_USER=65532:65532
DOCKER_RUNNER_PIDS_LIMIT=64

PORT=4180

# ── Demonstration module resource budgets (spec §9.2) ─────────────────────
# SceneDocument static budgets (server/demonstration/sceneSecurity.ts).
# Defaults match the spec HARD_BUDGET; override per cap for production. Leave
# unset to keep conservative v1 guardrails. Tuning tiers in docs/research.
# DEMO_BUDGET_MAX_NODES=2000
# DEMO_BUDGET_MAX_TRIANGLES=500000
# DEMO_BUDGET_MAX_TEXTURE_PIXELS=8388608
# DEMO_BUDGET_MAX_ANIMATION_SECONDS=600
# DEMO_BUDGET_MAX_MEDIA_REFS=200

# Per-kind media upload size caps (server/media/mediaGate.ts).
# Defaults match spec §9.2. Bytes; e.g. 26214400 = 25 MiB.
# MEDIA_LIMIT_IMAGE_BYTES=26214400
# MEDIA_LIMIT_GLB_BYTES=209715200
# MEDIA_LIMIT_VIDEO_BYTES=2147483648
# MEDIA_LIMIT_VTT_BYTES=2097152
# MEDIA_LIMIT_AUDIO_BYTES=262144000

# Per-teacher logical upload quota, bytes (server/media/QuotaService.ts).
# Default 5 GiB. Active upload_sessions reservations sum toward this.
# MEDIA_QUOTA_TEACHER_BYTES=5368709120

# Audit log integrity (HMAC-SHA256). Required for non-demo deployments.
# Demo falls back to a well-known local secret when unset.
AUDIT_HMAC_SECRET=change-me-before-any-real-student-data
# Optional path override; default is .data/audit.sqlite
# AUDIT_DB_PATH=.data/audit.sqlite

# Multimodal (Phase 1) — see ADR-0005
MULTIMODAL_ENABLED=false
VITE_MULTIMODAL_ENABLED=false

# STT provider: webspeech (default browser fallback) | aliyun | mock
STT_PROVIDER=webspeech
# Aliyun NLS (required when STT_PROVIDER=aliyun)
# ALIYUN_NLS_APP_KEY=
# ALIYUN_NLS_TOKEN=
# Optional gateway override (default: Shanghai public NLS gateway)
# ALIYUN_NLS_GATEWAY=wss://nls-gateway.cn-shanghai.aliyuncs.com/ws/v1
